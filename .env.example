# AI Assistant Configuration
# Choose your AI provider: 'google', 'openrouter', 'huggingface', 'ollama', or leave empty for mock responses

# Option 1: Google Gemini (RECOMMENDED!) - Free, 60 requests/minute
# Get API key from: https://makersuite.google.com/app/apikey
# NO CREDIT CARD NEEDED - Just click "Create API key"
VITE_AI_PROVIDER=google
VITE_API_KEY=AIzaSyD...

# Option 2: OpenRouter - Access to 100+ models
# Get API key from: https://openrouter.ai
# Free $5 credits for new users
# Models: GPT-4, Claude, Mistral, and more
# VITE_AI_PROVIDER=openrouter
# VITE_API_KEY=sk-or-YOUR_OPENROUTER_KEY_HERE

# Option 3: Hugging Face (Free - No credit card needed)
# Get token from: https://huggingface.co/settings/tokens
# VITE_AI_PROVIDER=huggingface
# VITE_API_KEY=hf_YourTokenHereXXXXXXXXXXXXXXXX

# Option 4: Ollama (Free - Local/Self-hosted)
# Install from: https://ollama.ai
# VITE_AI_PROVIDER=ollama
# VITE_OLLAMA_URL=http://localhost:11434

# Option 5: Together.ai (Free tier available)
# Get API key from: https://www.together.ai
# VITE_AI_PROVIDER=together
# VITE_API_KEY=YOUR_TOGETHER_KEY_HERE

# If all above are commented, the app will use mock responses (no API needed)
